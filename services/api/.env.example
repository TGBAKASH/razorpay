# Port number for the Fastify API server
PORT=4000

# Node execution environment (development | production | test)
NODE_ENV=production

# Neon PostgreSQL connection string (e.g. postgresql://user:password@host/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pool.neon.tech/dealflow_db?sslmode=require

# Allowed CORS origin for browser requests (e.g. https://dealflow-dashboard.onrender.com)
ALLOWED_ORIGIN=https://dealflow-dashboard.onrender.com

# Razorpay Test Key ID (starts with rzp_test_*)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Razorpay Test Key Secret
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Cryptographic secret key for signing offer contracts with HMAC-SHA256
SIGNING_SECRET=your_contract_hmac_signing_secret_here

# Google Gemini API key for natural language intent parsing
GEMINI_API_KEY=your_gemini_api_key_here
