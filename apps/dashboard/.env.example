# Node execution environment (development | production | test)
NODE_ENV=production

# Public API URL pointing to the deployed dealflow-api backend
NEXT_PUBLIC_API_URL=https://dealflow-api.onrender.com

# Razorpay Test Mode Key ID for Checkout.js modal (starts with rzp_test_*)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
